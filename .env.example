# Copy to .env and fill in. All optional: without keys the app runs in offline/simulated mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
HARD_CAP=500
PORT=3000

# Optional free fallback AI (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
